{
  "desktop": "xfce",
  "display_name": "Xfce",
  "packages": [
    "lightdm",
    "thunar",
    "thunar-archive-plugin",
    "xfce4-settings",
    "xfce4-panel",
    "xfce4-session",
    "xfdesktop",
    "xfwm4",
    "mousepad",
    "ristretto"
  ],
  "groups": ["@xfce-desktop"],
  "display_manager": "lightdm",
  "display_manager_package": "lightdm",
  "session": "xfce",
  "session_type": "x11",
  "services_enable": ["lightdm"],
  "use_wayland": false,
  "desktop_environment": {
    "name": "Xfce Desktop",
    "customizations_path": "configs/custom_files",
    "use_common_config": true,
    "copy_files": [
      {
        "source": "desktops/xfce/etc/skel",
        "destination": "/etc/skel"
      },
      {
        "source": "lightdm",
        "destination": "/etc/lightdm"
      }
    ]
  }
}
