{
  "desktop": "mate",
  "display_name": "MATE",
  "packages": [
    "lightdm",
    "mate-terminal",
    "caja",
    "mate-control-center",
    "mate-panel",
    "mate-session-manager",
    "marco",
    "pluma",
    "eom",
    "engrampa"
  ],
  "groups": ["@mate-desktop"],
  "display_manager": "lightdm",
  "display_manager_package": "lightdm",
  "session": "mate",
  "session_type": "x11",
  "services_enable": ["lightdm"],
  "use_wayland": false,
  "desktop_environment": {
    "name": "MATE Desktop",
    "customizations_path": "configs/custom_files",
    "use_common_config": true,
    "copy_files": [
      {
        "source": "lightdm",
        "destination": "/etc/lightdm"
      }
    ]
  }
}
