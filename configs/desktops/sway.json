{
  "desktop": "sway",
  "display_name": "Sway",
  "packages": [
    "sway",
    "waybar",
    "swaylock",
    "swayidle",
    "foot",
    "mako",
    "wofi",
    "grim",
    "slurp",
    "xdg-desktop-portal-wlr",
    "wl-clipboard",
    "sddm"
  ],
  "groups": [],
  "display_manager": "sddm",
  "display_manager_package": "sddm",
  "session": "sway",
  "session_type": "wayland",
  "services_enable": ["sddm"],
  "use_wayland": true,
  "desktop_environment": {
    "name": "Sway Compositor",
    "customizations_path": "configs/custom_files",
    "use_common_config": true,
    "copy_files": [
      {
        "source": "sddm",
        "destination": "/etc/sddm.conf.d"
      }
    ]
  }
}
