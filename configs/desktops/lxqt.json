{
  "desktop": "lxqt",
  "display_name": "LXQt",
  "packages": [
    "sddm",
    "lxqt-session",
    "lxqt-panel",
    "lxqt-runner",
    "lxqt-policykit",
    "pcmanfm-qt",
    "qterminal",
    "featherpad",
    "lximage-qt"
  ],
  "groups": ["@lxqt"],
  "display_manager": "sddm",
  "display_manager_package": "sddm",
  "session": "lxqt",
  "session_type": "x11",
  "services_enable": ["sddm"],
  "use_wayland": false,
  "desktop_environment": {
    "name": "LXQt Desktop",
    "customizations_path": "configs/custom_files",
    "use_common_config": true,
    "copy_files": [
      {
        "source": "sddm",
        "destination": "/etc/sddm.conf.d"
      }
    ]
  }
}
