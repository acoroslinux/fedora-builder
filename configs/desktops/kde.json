{
  "desktop": "kde",
  "display_name": "KDE Plasma",
  "packages": [
    "plasma-desktop",
    "plasma-workspace",
    "plasma-nm",
    "plasma-pa",
    "sddm",
    "sddm-kcm",
    "sddm-breeze",
    "dolphin",
    "konsole",
    "kate",
    "ark",
    "gwenview",
    "okular",
    "spectacle",
    "kde-settings-pulseaudio"
  ],
  "groups": ["@kde-desktop"],
  "display_manager": "sddm",
  "display_manager_package": "sddm",
  "session": "plasma",
  "session_type": "wayland",
  "services_enable": ["sddm"],
  "use_wayland": true,
  "desktop_environment": {
    "name": "KDE Plasma Desktop",
    "customizations_path": "configs/custom_files",
    "use_common_config": true,
    "copy_files": [
      {
        "source": "desktops/kde/etc/skel",
        "destination": "/etc/skel"
      },
      {
        "source": "sddm",
        "destination": "/etc/sddm.conf.d"
      }
    ]
  }
}
