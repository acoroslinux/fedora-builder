{
  "desktop": "kde",
  "display_name": "KDE Plasma",
  "packages": [
    "plasma-desktop",
    "plasma-workspace",
    "plasma-nm",
    "plasma-pa",
    "sddm",
    "sddm-kcm",
    "sddm-breeze",
    "dolphin",
    "konsole",
    "kate",
    "ark",
    "gwenview",
    "okular",
    "spectacle",
    "kde-settings-pulseaudio"
  ],
  "groups": ["@kde-desktop"],
  "display_manager": "sddm",
  "display_manager_package": "sddm",
  "session": "plasma",
  "session_type": "wayland",
  "services_enable": ["sddm"],
  "use_wayland": true
}
