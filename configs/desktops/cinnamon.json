{
  "desktop": "cinnamon",
  "display_name": "Cinnamon",
  "packages": [
    "lightdm",
    "lightdm-gtk",
    "cinnamon",
    "cinnamon-control-center",
    "nemo",
    "nemo-fileroller",
    "gnome-terminal",
    "xed",
    "xviewer"
  ],
  "groups": ["@cinnamon-desktop"],
  "display_manager": "lightdm",
  "display_manager_package": "lightdm",
  "session": "cinnamon",
  "session_type": "x11",
  "services_enable": ["lightdm"],
  "use_wayland": false,
  "desktop_environment": {
    "name": "Cinnamon Desktop",
    "customizations_path": "configs/custom_files",
    "use_common_config": true,
    "copy_files": [
      {
        "source": "lightdm",
        "destination": "/etc/lightdm"
      }
    ]
  }
}
