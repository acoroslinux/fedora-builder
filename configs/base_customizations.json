{
  "base_copy_files": [
    {
      "source": "autostart",
      "destination": "/etc/xdg/autostart"
    },
    {
      "source": "applications",
      "destination": "/usr/share/applications"
    },
    {
      "source": "plymouth/themes/fedora-modern",
      "destination": "/usr/share/plymouth/themes/fedora-modern"
    },
    {
      "source": "grub/modern",
      "destination": "/usr/share/grub/themes/modern"
    },
    {
      "source": "boot/grub2/themes/fedora-modern",
      "destination": "/boot/grub2/themes/fedora-modern"
    },
    {
      "source": "samba",
      "destination": "/etc/samba"
    },
    {
      "source": "sudoers.d",
      "destination": "/etc/sudoers.d"
    },
    {
      "source": "usr/share/backgrounds/fedora-modern",
      "destination": "/usr/share/backgrounds/fedora-modern"
    }
  ]
}
